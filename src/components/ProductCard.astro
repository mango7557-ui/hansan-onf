---
import Art from './Art.astro';
const {product:p}=Astro.props;
---
<a class="product-card" href={`/products/${p.slug}/`} data-category={p.category}>
 <div class:list={['product-art',{'is-material':!p.image}]} data-slug={p.slug}>
  {p.image?<Art name={`${p.slug}-cutout` as any} alt={`한산 ${p.name} 18L 제품`} widths={[320,480,750]} sizes="(max-width: 760px) 45vw, 30vw"/>:<><Art name="oil-study" alt="맑은 식용유의 질감" widths={[480,760,1024]} sizes="(max-width: 760px) 45vw, 30vw"/><span>{p.slug==='custom'?'맞춤 배합':p.name.replace('프리미엄 ','').replace('맑은 ','')}</span></>}
 </div>
 <h3>한산 {p.name}</h3>
 <p>{p.use.join(', ')}</p>
 <span class="capacity">{p.slug==='custom'?'18L 캔 또는 벌크, 협의':'18L 캔'}</span>
</a>
