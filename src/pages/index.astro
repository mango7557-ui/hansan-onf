---
import Layout from '../layouts/Layout.astro';
import Art from '../components/Art.astro';
import {loadContent} from '../data/content.ts';
const {products,faqs,home}=await loadContent();
const schema=[{'@type':'FAQPage',mainEntity:faqs.slice(0,4).map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}];
const featured=products.slice(0,4);
const pillars=[
 {en:'Develop',ko:'전용유 개발',desc:'브랜드 메뉴에 맞는 배합을 설계하고 샘플로 검증합니다.',href:'/business/#oem',img:'card-develop'},
 {en:'Produce',ko:'제조 · 소분',desc:'천안 공장에서 로트 단위로 같은 품질을 만듭니다.',href:'/quality/',img:'card-process'},
 {en:'Product',ko:'제품',desc:'콩·카놀라·해바라기·옥수수유 18L와 맞춤 전용유.',href:'/products/',img:'oil-study'},
 {en:'Partner',ko:'가맹점 공급',desc:'전국 협력 유통망으로 모든 매장에 납품합니다.',href:'/business/#distribution',img:'card-partner'},
];
---
<Layout home title="프랜차이즈 전용유 개발 · 업소용 식용유 제조" schema={schema}>
 <!-- Hero: thin display word + bold amber keyword overlapped, BNB "Speedy Helper / Celper" pattern -->
 <section class="hero">
  <div class="hero-art">
   <Art name="hero-poster" alt="어두운 배경 위로 흐르는 황금빛 식용유" widths={[480,760,864]} sizes="100vw" loading="eager" fetchpriority="high" class="hero-still"/>
   <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/images/oil-sculpture.webp" width="864" height="496" aria-hidden="true" tabindex="-1" disablepictureinpicture disableremoteplayback>
    <source src="/videos/hero-loop.webm" type="video/webm"/>
    <source src="/videos/hero-loop.mp4" type="video/mp4"/>
   </video>
   <div class="hero-glow"></div>
  </div>
  <div class="hero-copy container">
   <p class="hero-display" aria-hidden="true"><span class="thin">Franchise</span><span class="bold">Oil Partner</span></p>
   <h1 class="hero-h1">{home.heroTitle.split('\n').map((line:string)=><span class="line"><span>{line}</span></span>)}</h1>
   <p class="hero-lede">{home.heroLede}</p>
   <div class="hero-actions actions"><a class="button" href="/business/#oem">프랜차이즈 전용유 개발 상담</a><a class="text-link" href="/products/">제품 살펴보기</a></div>
  </div>
  <div class="hero-bottom container">
   <a href="#pillars" class="scroll-indicator" aria-label="아래로 스크롤"><span class="ring" aria-hidden="true"><svg viewBox="0 0 100 100"><defs><path id="circ" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0"/></defs><text><textPath href="#circ">scroll down&#8195;&#8195;scroll down&#8195;&#8195;</textPath></text></svg></span><span class="arrow" aria-hidden="true">↓</span></a>
   <button class="hero-video-toggle" type="button" aria-pressed="false" aria-label="배경 영상 일시정지"><span class="icon-pause" aria-hidden="true"></span><span class="icon-play" aria-hidden="true"></span></button>
  </div>
 </section>

 <!-- 01 Pillars: giant English title + Korean lede, then 4 image cards with white label — BNB "ODM" section -->
 <section id="pillars" class="section">
  <div class="container">
   <div class="bnb-title"><h2><span class="big">OEM</span><span class="light">· ODM</span></h2><p>프랜차이즈 본사보다 먼저 메뉴를 고민합니다. 배합 설계부터 가맹점 납품까지,<br class="desktop-break"/>브랜드가 기대하는 것 이상의 전용유를 만들기 위해 끊임없이 테스트합니다.</p></div>
   <div class="pillar-grid">
    {pillars.map((c,i)=><a class="pillar" href={c.href} style={`--i:${i}`}><Art name={c.img as any} alt="" widths={[400,600,880]} sizes="(max-width: 760px) 50vw, 25vw"/><span class="pillar-label"><strong>{c.en}</strong><em>{c.ko}</em></span><span class="pillar-desc">{c.desc}</span></a>)}
   </div>
  </div>
 </section>

 <!-- 02 Products: tabs (kept) -->
 <section class="section surface" id="products"><div class="container">
  <div class="bnb-title compact"><h2><span class="big">Products</span></h2><p>주방마다 맞는 기름이 다릅니다. 네 가지 기본 유지에 더해, 프랜차이즈 브랜드를 위한 맞춤 전용유를 개발합니다.</p></div>
  <div class="collection-tabs" role="tablist" aria-label="대표 제품">{featured.map((p,i)=><button id={`tab-${p.slug}`} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`panel-${p.slug}`} tabindex={i===0?0:-1}>{p.name.replace('프리미엄 ','').replace('맑은 ','')}</button>)}</div>
  {featured.map((p,i)=><article class="collection-panel" role="tabpanel" id={`panel-${p.slug}`} aria-labelledby={`tab-${p.slug}`} hidden={i!==0} tabindex="0">
   <figure class:list={['collection-visual',{'is-material':!p.image}]}>{p.image?<Art name={`${p.slug}-cutout` as any} alt={`한산 ${p.name} 18L 제품`} widths={[400,600,750]} sizes="(max-width: 760px) 90vw, 40vw"/>:<Art name="oil-study" alt="맑은 식용유의 질감" widths={[480,760,1024,1248]} sizes="(max-width: 760px) 100vw, 45vw"/>}</figure>
   <div class="collection-detail"><h3>한산 {p.name} 18L</h3><p class="tagline">{p.type}</p><p class="desc">{p.desc}</p><dl class="spec"><div><dt>잘 맞는 메뉴</dt><dd>{p.use.join(', ')}</dd></div><div><dt>원재료</dt><dd>{p.ingredient}</dd></div><div><dt>공급</dt><dd>18L 캔, 물량별 상담</dd></div></dl><a class="text-link" href={`/products/${p.slug}/`}>{p.name} 자세히 보기</a></div>
  </article>)}
  <p style="margin-top:32px"><a class="text-link" href="/products/">전체 제품 보기</a></p>
 </div></section>

 <!-- 03 Process: centered giant title over soft photo, two feature tiles — BNB "R&D" section -->
 <section class="section rnd-section">
  <div class="rnd-bg" aria-hidden="true"><Art name="culinary-study" alt="" widths={[760,912]} sizes="100vw"/></div>
  <div class="container rnd-inner">
   <div class="bnb-title centered"><p class="since">Since 2023</p><h2><span class="big">Process</span></h2><p>프랜차이즈 본사와 조리 매뉴얼을 함께 읽고, 샘플을 실제 매장 조건에서 튀겨 보고,<br class="desktop-break"/>확정한 배합을 로트마다 같은 품질로 생산합니다. 다섯 단계, 하나의 기준.</p></div>
   <ol class="rnd-steps">
    <li><span>01</span><strong>상담</strong><em>메뉴, 사용량, 조리 조건</em></li>
    <li><span>02</span><strong>배합 설계</strong><em>원료 비율, 샘플 제작</em></li>
    <li><span>03</span><strong>조리 테스트</strong><em>매장 조건에서 검증</em></li>
    <li><span>04</span><strong>규격 확정</strong><em>용량, 포장, 라벨</em></li>
    <li><span>05</span><strong>양산 · 공급</strong><em>로트 생산, 가맹점 납품</em></li>
   </ol>
   <div class="rnd-tiles">
    <a class="rnd-tile accent" href="/business/#oem"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M18 6h12M20 6v12L9 36a4 4 0 0 0 3.5 6h23a4 4 0 0 0 3.5-6L28 18V6"/><path d="M14 30h20"/></svg><strong>전용유 개발</strong><em>OEM · ODM 상담</em></a>
    <a class="rnd-tile" href="/quality/"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 4 8 10v12c0 10 7 17 16 20 9-3 16-10 16-20V10z"/><path d="m17 24 5 5 10-10"/></svg><strong>품질관리</strong><em>원료 입고 → 출고 4단계</em></a>
   </div>
  </div>
 </section>

 <!-- 04 Partner-type cards (who we serve) -->
 <section class="section dark">
  <div class="container">
   <div class="bnb-title"><h2><span class="big">Partners</span></h2><p>치킨·돈까스·중식 프랜차이즈 본사, 식자재 유통사, 단체급식까지. 메뉴와 규모가 달라도 기름의 기준은 같아야 합니다.</p></div>
   <div class="rows">
    <a class="row" href="/business/#oem"><h3>프랜차이즈 본사</h3><p>브랜드 전용 배합을 개발하고 전 가맹점에 같은 품질로 일괄 공급합니다. 브랜드 라벨 OEM 가능.</p><span class="text-link">전용유 개발 보기</span></a>
    <a class="row" href="/products/"><h3>식자재 유통사</h3><p>콩·카놀라·해바라기·옥수수유 18L 캔을 권역 물류 조건에 맞춰 정기 납품합니다.</p><span class="text-link">제품 보기</span></a>
    <a class="row" href="/business/#circular"><h3>급식 · 대량 조리</h3><p>신유 납품과 폐식용유 수거 연계까지 운영 편의를 함께 설계합니다.</p><span class="text-link">자원순환 보기</span></a>
   </div>
  </div>
 </section>

 <!-- 05 Guide + FAQ (kept, lighter) -->
 <section class="section surface-amber"><div class="container guide-promo">
  <a class="guide-cover" href="/guide/" aria-label="업소용 식용유 선택 가이드 읽기"><Art name="oil-study" alt="" widths={[480,760,1024,1248]} sizes="(max-width: 760px) 100vw, 42vw"/><span aria-hidden="true">Guide</span></a>
  <div><div class="bnb-title compact"><h2><span class="big">Guide</span></h2><p>콩식용유, 카놀라유, 해바라기유, 옥수수유의 차이와 용도, 프랜차이즈 전용유가 필요한 경우, 첫 상담 전에 준비하면 좋은 것들을 정리했습니다.</p></div><p><a class="text-link" href="/guide/">가이드 읽기</a></p></div>
 </div></section>

 <section class="section container faq">
  <div><div class="bnb-title compact"><h2><span class="big">FAQ</span></h2><p>상담 전에 자주 확인하시는 내용입니다.</p></div><p><a class="text-link" href="/guide/#faq">질문 전체 보기</a></p></div>
  <div class="faq-list">{faqs.slice(0,4).map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
 </section>

 <section class="closing dark"><div class="container"><div class="bnb-title"><h2><span class="big">Contact</span></h2><p>{home.closingTitle}</p></div><div class="actions"><a class="button" href="/contact/">상담 문의하기</a><a class="text-link" href="tel:041-414-5153">041-414-5153</a></div></div></section>

 <script>
 const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('.collection-tabs [role=tab]'));
 function activate(tab:HTMLButtonElement,focus=false){tabs.forEach(item=>{const active=item===tab;item.setAttribute('aria-selected',String(active));item.tabIndex=active?0:-1;const panel=document.getElementById(item.getAttribute('aria-controls')||'');if(panel)panel.hidden=!active});if(focus)tab.focus()}
 const video=document.querySelector<HTMLVideoElement>('.hero-video');
 const toggle=document.querySelector<HTMLButtonElement>('.hero-video-toggle');
 const reduceMotion=matchMedia('(prefers-reduced-motion: reduce)');
 let userPaused=false;
 function syncToggle(){if(!video||!toggle)return;const paused=video.paused;toggle.setAttribute('aria-pressed',String(paused));toggle.setAttribute('aria-label',paused?'배경 영상 재생':'배경 영상 일시정지');toggle.classList.toggle('is-paused',paused)}
 function play(){if(video&&!userPaused&&!reduceMotion.matches&&!document.hidden)video.play().catch(()=>{})}
 if(video){
  if(reduceMotion.matches){video.removeAttribute('autoplay');video.pause();video.classList.add('is-hidden')}
  const markReady=()=>video.classList.add('is-ready');
  if(video.readyState>=3)markReady();else video.addEventListener('canplay',markReady,{once:true});
  video.addEventListener('play',syncToggle);video.addEventListener('pause',syncToggle);
  document.addEventListener('visibilitychange',()=>document.hidden?video.pause():play());
  reduceMotion.addEventListener('change',e=>{if(e.matches){video.pause();video.classList.add('is-hidden')}else{video.classList.remove('is-hidden');play()}});
  toggle?.addEventListener('click',()=>{if(video.paused){userPaused=false;video.classList.remove('is-hidden');video.play().catch(()=>{})}else{userPaused=true;video.pause()}syncToggle()});
  syncToggle();
 }
 tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>activate(tab));tab.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight')next=(index+1)%tabs.length;else if(event.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();activate(tabs[next],true)})});
 </script>
</Layout>
