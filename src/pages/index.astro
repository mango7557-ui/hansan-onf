---
import Layout from '../layouts/Layout.astro';
import Art from '../components/Art.astro';
import {products,faqs} from '../data/site.js';
const schema=[{'@type':'FAQPage',mainEntity:faqs.slice(0,4).map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}];
const featured=products.slice(0,4);
---
<Layout home title="업소용 식용유 제조와 브랜드 전용유 개발" schema={schema}>
 <section class="hero">
  <div class="hero-copy">
   <p class="hero-kicker"><span>충남 천안에서 만드는 식물성 유지</span></p>
   <h1><span class="line"><span>좋은 요리는</span></span><span class="line"><span>좋은 기름에서</span></span><span class="line"><span>시작됩니다.</span></span></h1>
   <p class="hero-lede">한산오앤에프는 업소용 식용유를 만들고, 외식 브랜드에 맞는 전용유를 개발해 전국으로 공급합니다. 튀김의 식감부터 주방의 일관성까지, 기름이 바꾸는 차이를 함께 만듭니다.</p>
   <div class="hero-actions actions"><a class="button" href="/products/">제품 살펴보기</a><a class="text-link" href="/business/#oem">전용유 개발 상담</a></div>
  </div>
  <div class="hero-art">
   <Art name="hero-poster" alt="어두운 배경 위로 흐르는 황금빛 식용유" widths={[480,760,864]} sizes="(max-width: 760px) 100vw, 48vw" loading="eager" fetchpriority="high" class="hero-still"/>
   <video class="hero-video" autoplay muted loop playsinline preload="metadata" width="864" height="496" aria-hidden="true" tabindex="-1" disablepictureinpicture disableremoteplayback>
    <source src="/videos/hero-loop.webm" type="video/webm"/>
    <source src="/videos/hero-loop.mp4" type="video/mp4"/>
   </video>
   <button class="hero-video-toggle" type="button" aria-pressed="false" aria-label="배경 영상 일시정지"><span class="icon-pause" aria-hidden="true"></span><span class="icon-play" aria-hidden="true"></span></button>
   <div class="hero-glow"></div>
  </div>
  <p class="hero-foot">영상은 한산 식용유의 질감을 표현한 연출 이미지입니다. <a href="/products/soybean/">실제 제품 보기</a></p>
 </section>

 <section class="section container intro">
  <div><span class="kicker">한산오앤에프</span><h2>기름은 재료 뒤에 숨어 있지만,<br/>맛의 차이는 가장 먼저 드러납니다.</h2></div>
  <div class="prose"><p>튀김이 얼마나 바삭한지, 재료의 풍미가 얼마나 살아 있는지, 매일 같은 맛이 나오는지. 그 많은 부분이 어떤 기름을 쓰느냐에 달려 있습니다.</p><p>한산오앤에프는 식물성 유지를 직접 제조·소분하고, 브랜드의 조리 방식에 맞는 전용유를 개발하며, 천안 공장을 거점으로 전국에 공급합니다. 2023년에 시작해 외식 프랜차이즈, 식자재 유통사, 급식 현장과 함께하고 있습니다.</p><p><a class="text-link" href="/about/">회사 소개 읽기</a></p></div>
  <dl class="facts" style="grid-column:1/-1">
   <div><dt>본사와 공장</dt><dd>충남 천안<small>중부권 거점에서 전국으로</small></dd></div>
   <div><dt>하는 일</dt><dd>제조 · 소분 · 전용유 개발<small>18L 캔부터 벌크 공급까지</small></dd></div>
   <div><dt>품질 기준</dt><dd>원료 입고부터 출고까지<small><a class="text-link" href="/quality/">품질관리 과정 보기</a></small></dd></div>
  </dl>
 </section>

 <section class="section surface" id="products"><div class="container">
  <div class="collection-head"><div><span class="kicker">제품</span><h2>주방마다 맞는 기름이 다릅니다.</h2></div><a class="text-link" href="/products/">전체 제품 보기</a></div>
  <div class="collection-tabs" role="tablist" aria-label="대표 제품">{featured.map((p,i)=><button id={`tab-${p.slug}`} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`panel-${p.slug}`} tabindex={i===0?0:-1}>{p.name.replace('프리미엄 ','').replace('맑은 ','')}</button>)}</div>
  {featured.map((p,i)=><article class="collection-panel" role="tabpanel" id={`panel-${p.slug}`} aria-labelledby={`tab-${p.slug}`} hidden={i!==0} tabindex="0">
   <figure class:list={['collection-visual',{'is-material':!p.image}]}>{p.image?<Art name={`${p.slug}-cutout` as any} alt={`한산 ${p.name} 18L 제품`} widths={[400,600,750]} sizes="(max-width: 760px) 90vw, 40vw"/>:<Art name="oil-study" alt="맑은 식용유의 질감" widths={[480,760,1024,1248]} sizes="(max-width: 760px) 100vw, 45vw"/>}<figcaption>{p.image?'실제 유통 제품 사진':'질감 연출 이미지 · 실제 포장과 다릅니다'}</figcaption></figure>
   <div class="collection-detail"><h3>한산 {p.name} 18L</h3><p class="tagline">{p.type}</p><p class="desc">{p.desc}</p><dl class="spec"><div><dt>잘 맞는 메뉴</dt><dd>{p.use.join(', ')}</dd></div><div><dt>원재료</dt><dd>{p.ingredient}</dd></div><div><dt>공급</dt><dd>18L 캔, 물량별 상담</dd></div></dl><a class="text-link" href={`/products/${p.slug}/`}>{p.name} 자세히 보기</a></div>
  </article>)}
 </div></section>

 <section class="craft dark">
  <div class="craft-photo"><Art name="culinary-study" alt="바삭하게 튀겨진 새우튀김과 맑은 기름이 담긴 그릇" widths={[480,760,912]} sizes="(max-width: 760px) 100vw, 50vw"/></div>
  <div class="craft-body"><span class="kicker">브랜드 전용유 개발</span><h2>치킨, 돈까스, 중식.<br/>메뉴가 다르면 기름의 배합도 달라야 합니다.</h2><p class="lede">조리 온도와 시간, 원하는 식감과 풍미를 듣고 대두유·카놀라유 등 원료의 배합을 설계합니다. 샘플로 실제 조리 테스트를 거친 뒤 양산합니다.</p>
   <ol class="process"><li><div><strong>상담</strong><span>메뉴, 월 사용량, 조리 조건을 확인합니다.</span></div></li><li><div><strong>배합 설계와 샘플</strong><span>원료 비율을 설계하고 샘플을 만듭니다.</span></div></li><li><div><strong>조리 테스트</strong><span>실제 조리 환경에서 맛과 식감을 확인하고 조정합니다.</span></div></li><li><div><strong>규격 확정과 양산</strong><span>용량, 포장, 일정을 확정하고 공급을 시작합니다.</span></div></li></ol>
   <a class="button" href="/contact/?type=oem">전용유 개발 문의하기</a></div>
 </section>

 <section class="section dark"><div class="container">
  <span class="kicker">함께 하는 일</span><h2>만드는 것에서 끝나지 않습니다.</h2>
  <div class="rows">
   <a class="row" href="/quality/"><h3>원료 입고부터 출고까지 품질관리</h3><p>원료 확인, 저장과 충진 공정 관리, 산가·과산화물가·수분 검사, 완제품 확인을 거칩니다.</p><span class="text-link">품질관리 보기</span></a>
   <a class="row" href="/business/#distribution"><h3>천안에서 전국으로 공급</h3><p>천안 공장을 거점으로 수도권·충청·영남·호남 협력 유통망과 연결해 납품합니다.</p><span class="text-link">공급망 보기</span></a>
   <a class="row" href="/business/#circular"><h3>폐식용유 수거 연계</h3><p>새 기름을 납품하면서 쓰고 난 기름의 수거까지 지역별 협력망을 통해 상담합니다.</p><span class="text-link">자원순환 보기</span></a>
  </div>
 </div></section>

 <section class="section surface-amber"><div class="container guide-promo">
  <a class="guide-cover" href="/guide/" aria-label="업소용 식용유 선택 가이드 읽기"><Art name="oil-study" alt="" widths={[480,760,1024,1248]} sizes="(max-width: 760px) 100vw, 42vw"/><span aria-hidden="true">오일 가이드</span></a>
  <div><span class="kicker">가이드</span><h2>우리 매장에는 어떤 기름이 맞을까요?</h2><p class="lede" style="margin-top:20px">콩식용유, 카놀라유, 해바라기유, 옥수수유의 차이와 용도, 첫 공급 상담 전에 준비하면 좋은 것들을 정리했습니다.</p><p style="margin-top:28px"><a class="text-link" href="/guide/">가이드 읽기</a></p></div>
 </div></section>

 <section class="section container faq">
  <div><span class="kicker">자주 묻는 질문</span><h2>상담 전에 자주 확인하시는 내용입니다.</h2><p style="margin-top:24px"><a class="text-link" href="/guide/#faq">질문 전체 보기</a></p></div>
  <div class="faq-list">{faqs.slice(0,4).map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
 </section>

 <section class="closing dark"><div class="container"><span class="kicker">문의</span><h2>어떤 기름이 필요한지 이야기해 주세요. 제품과 공급 조건을 함께 찾겠습니다.</h2><div class="actions"><a class="button" href="/contact/">상담 문의하기</a><a class="text-link" href="tel:041-414-5153">041-414-5153</a></div></div></section>

 <script>
 const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('.collection-tabs [role=tab]'));
 function activate(tab:HTMLButtonElement,focus=false){tabs.forEach(item=>{const active=item===tab;item.setAttribute('aria-selected',String(active));item.tabIndex=active?0:-1;const panel=document.getElementById(item.getAttribute('aria-controls')||'');if(panel)panel.hidden=!active});if(focus)tab.focus()}
 // Hero video: autoplay only when motion is allowed and the tab is visible.
 // Provides a pause control (WCAG 2.2.2) and falls back to the poster image under prefers-reduced-motion.
 const video=document.querySelector<HTMLVideoElement>('.hero-video');
 const toggle=document.querySelector<HTMLButtonElement>('.hero-video-toggle');
 const reduceMotion=matchMedia('(prefers-reduced-motion: reduce)');
 let userPaused=false;
 function syncToggle(){if(!video||!toggle)return;const paused=video.paused;toggle.setAttribute('aria-pressed',String(paused));toggle.setAttribute('aria-label',paused?'배경 영상 재생':'배경 영상 일시정지');toggle.classList.toggle('is-paused',paused)}
 function play(){if(video&&!userPaused&&!reduceMotion.matches&&!document.hidden)video.play().catch(()=>{})}
 if(video){
  if(reduceMotion.matches){video.removeAttribute('autoplay');video.pause();video.classList.add('is-hidden')}
  const markReady=()=>video.classList.add('is-ready');
  if(video.readyState>=3)markReady();else video.addEventListener('canplay',markReady,{once:true});
  video.addEventListener('play',syncToggle);video.addEventListener('pause',syncToggle);
  document.addEventListener('visibilitychange',()=>document.hidden?video.pause():play());
  reduceMotion.addEventListener('change',e=>{if(e.matches){video.pause();video.classList.add('is-hidden')}else{video.classList.remove('is-hidden');play()}});
  toggle?.addEventListener('click',()=>{if(video.paused){userPaused=false;video.classList.remove('is-hidden');video.play().catch(()=>{})}else{userPaused=true;video.pause()}syncToggle()});
  syncToggle();
 }
 tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>activate(tab));tab.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight')next=(index+1)%tabs.length;else if(event.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();activate(tabs[next],true)})});
 </script>
</Layout>
