---
import Layout from '../../layouts/Layout.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import ProductCard from '../../components/ProductCard.astro';
import {products} from '../../data/site.js';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}))}
const {product:p}=Astro.props;
const schema=[{'@type':'Product',name:`한산 ${p.name}${p.slug==='custom'?'':' 18L'}`,description:p.desc,brand:{'@type':'Brand',name:'한산'},category:'업소용 식물성 식용유',size:p.slug==='custom'?'18L 캔 / 대용량 벌크':'18L',material:p.ingredient,additionalProperty:[{'@type':'PropertyValue',name:'적용 규격',value:p.standard}]},...(Astro.site?[{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'홈',item:Astro.site.href},{'@type':'ListItem',position:2,name:'제품안내',item:new URL('/products/',Astro.site).href},{'@type':'ListItem',position:3,name:p.name,item:new URL(`/products/${p.slug}/`,Astro.site).href}]}]:[])];
---
<Layout title={`${p.name} ${p.slug==='custom'?'OEM·ODM':'18L'} · 제품 규격`} description={p.desc} schema={schema}>
 <section class="section container">
  <nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span>/</span><a href="/products/">제품안내</a><span>/</span><span aria-current="page">{p.name}</span></nav>
  <div class="product-detail">
   <div><ProductVisual product={p}/>{p.image&&<p class="source-line">사진 출처: <a href={`https://cheongil.co.kr/shop_view/?idx=${p.slug==='soybean'?'80':'81'}`} target="_blank" rel="noopener noreferrer">청일유통 제품 안내</a></p>}</div>
   <div class="detail-copy"><h1>한산 {p.name} {p.slug==='custom'?'':'18L'}</h1><p class="tagline">{p.type}</p><p class="desc">{p.desc}</p><div class="tags">{p.use.map(tag=><span>{tag}</span>)}</div>
    <table class="info-table"><tbody><tr><th scope="row">내용량</th><td>{p.slug==='custom'?'18L 캔 또는 대용량 벌크, 협의':'18L 캔'}</td></tr><tr><th scope="row">원재료</th><td>{p.ingredient}</td></tr><tr><th scope="row">포장</th><td>{p.slug==='custom'?'스틸 캔 또는 전용 용기, 협의':'스틸 캔, 폴리에틸렌 마개'}</td></tr><tr><th scope="row">규격 기준</th><td>{p.standard}</td></tr><tr><th scope="row">알레르기</th><td>{p.allergy}</td></tr><tr><th scope="row">단가 · 납기</th><td>물량과 납품 조건에 따라 상담</td></tr></tbody></table>
    <a class="button" href={`/contact/?product=${p.slug}`}>이 제품 공급 상담하기</a>
   </div>
  </div>
  <p class="note" style="margin-top:40px">원재료 원산지는 공급 로트에 따라 달라질 수 있습니다. 소비기한, 보관 방법, 알레르기 등 최종 정보는 출고 제품의 표시사항을 확인해 주세요. 규격 기준 표시는 인증 취득을 뜻하지 않습니다.</p>
 </section>
 <section class="section surface"><div class="container"><div class="collection-head"><div><span class="kicker">다른 제품</span><h2>함께 비교해 보세요.</h2></div><a class="text-link" href="/products/">전체 제품 보기</a></div><div class="product-grid">{products.filter(item=>item.slug!==p.slug).slice(0,3).map(product=><ProductCard product={product}/>)}</div></div></section>
</Layout>
