---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
import {loadContent} from '../../data/content.ts';
const {products}=await loadContent();
---
<Layout title="제품안내 · 업소용 식용유 18L" description="한산 프리미엄 콩식용유·카놀라유·해바라기유·옥수수유 18L와 OEM 맞춤 전용유를 용도별로 비교하세요. 원재료, 포장 규격, 납품 상담을 확인할 수 있습니다.">
 <PageHero label="제품안내" title="매일의 조리부터<br/>브랜드의 시그니처 메뉴까지." crumb="제품안내" description="사용 환경과 조리 목적에 맞는 한산의 유지류를 골라보세요. 기본 제품으로 맞지 않는 메뉴는 프랜차이즈 전용유로 배합을 설계합니다."><button id="print-catalog" class="button ghost">카탈로그 인쇄 · PDF 저장</button></PageHero>
 <section class="section container products-page">
  <div class="filter-bar" role="group" aria-label="용도별 필터">{[['all','전체'],['frying','튀김과 범용'],['bakery','베이커리'],['stir','중식과 볶음'],['custom','맞춤 전용유']].map(([value,label])=><button class="filter-button" data-filter={value} aria-pressed={value==='all'}>{label}</button>)}</div>
  <h2 class="visually-hidden">제품 목록</h2>
  <p class="filter-count" aria-live="polite"><strong id="product-count">6</strong>개 제품</p>
  <div class="product-grid">{products.map(product=><ProductCard product={product}/>)}</div>
  <p class="note" style="margin-top:40px">콩식용유와 해바라기유는 유통처에 공개된 실제 제품 사진입니다. 다른 제품의 이미지는 기름의 질감을 표현한 연출 이미지이며, 최종 원재료와 포장은 출고 제품의 표시사항을 확인해 주세요.</p>
  <div class="inline-cta"><div><h3>프랜차이즈 브랜드이신가요?</h3><p>기본 제품 외에 브랜드 메뉴에 맞춘 전용유 개발이 가능합니다. 조리 메뉴, 가맹점 수, 월 사용량을 알려주시면 배합과 공급 단위를 함께 설계합니다.</p></div><a class="text-link" href="/business/#oem">전용유 개발 과정 보기</a></div>
 </section>
 <script>
 document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{const value=button.dataset.filter;let count=0;document.querySelectorAll('[data-filter]').forEach(el=>el.setAttribute('aria-pressed',String(el===button)));document.querySelectorAll<HTMLElement>('[data-category]').forEach(card=>{card.hidden=value!=='all'&&card.dataset.category!==value;if(!card.hidden)count++});const output=document.querySelector('#product-count');if(output)output.textContent=String(count)}));document.querySelector('#print-catalog')?.addEventListener('click',()=>window.print());
 </script>
</Layout>
