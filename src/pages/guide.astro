---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import {loadContent} from '../data/content.ts';
const {products,faqs}=await loadContent();
const schema=[{'@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}];
---
<Layout title="업소용 식용유 선택 가이드 · 제품 비교와 FAQ" description="콩식용유, 카놀라유, 해바라기유, 옥수수유를 어떻게 선택할까요? 업소용 식용유 18L의 용도별 비교, OEM 개발 절차, 주문·배송 관련 자주 묻는 질문을 확인하세요." schema={schema}>
 <PageHero label="오일 가이드" title="우리 매장에 맞는 기름을<br/>고르는 방법" crumb="오일 가이드" description="정답은 주방마다 다릅니다. 메뉴와 조리 조건, 사용하는 양을 함께 보면 맞는 기름을 찾을 수 있습니다."/>
 <section class="section container">
  <span class="kicker">한눈에 비교</span><h2>네 가지 기름, 네 가지 쓰임</h2>
  <p class="prose" style="margin:24px 0 36px">범용 조리에는 콩식용유, 깔끔한 풍미의 튀김에는 카놀라유, 베이커리와 섬세한 튀김에는 해바라기유, 고소한 중식과 부침에는 옥수수유를 비교해 보세요. 최종 선택은 실제 메뉴의 조리 테스트와 공급 조건을 함께 확인하는 것이 좋습니다.</p>
  <div class="guide-table-wrap" role="region" aria-label="식용유 제품 비교 표" tabindex="0"><table class="guide-table"><thead><tr><th scope="col">제품</th><th scope="col">풍미와 사용 방향</th><th scope="col">잘 맞는 메뉴</th><th scope="col">규격</th></tr></thead><tbody>{products.slice(0,4).map(p=><tr><td><a href={`/products/${p.slug}/`}>{p.name}</a></td><td>{p.type}</td><td>{p.use.join(', ')}</td><td>18L 캔</td></tr>)}</tbody></table></div>
 </section>
 <section class="section dark"><article class="container guide-article">
  <span class="kicker">첫 상담 전에</span><h2>네 가지를 준비하면 상담이 빨라집니다.</h2>
  <ol><li><strong>조리 메뉴와 사용 환경.</strong> 튀김, 볶음, 부침 등 주로 쓰는 조리 방식과 지금 사용 중인 제품.</li><li><strong>월 예상 사용량.</strong> 18L 캔 기준 수량이나 벌크 물량, 매장 수.</li><li><strong>배송 지역과 희망 일정.</strong> 납품 주소, 정기 공급 주기, 첫 납품 희망일.</li><li><strong>브랜드별 추가 조건.</strong> 전용 배합, 전용 용기, 표시사항, 품질 자료 등.</li></ol>
  <h2>발연점 숫자 하나로 고르지 마세요.</h2>
  <p>식용유의 조리 적합성은 원료 종류 외에도 정제 상태, 실제 조리 온도, 가열 시간, 식재료 조건의 영향을 받습니다. 특정 수치만으로 적합성이나 교체 주기를 판단하기보다 제품의 최신 품질 자료와 현장 관리 기준을 함께 확인하는 것이 좋습니다.</p>
  <p style="margin-top:32px"><a class="text-link" href="/contact/">우리 매장 공급 조건 상담하기</a></p>
 </article></section>
 <section id="faq" class="section container faq">
  <div><span class="kicker">자주 묻는 질문</span><h2>상담 전에 자주 확인하시는 내용입니다.</h2></div>
  <div class="faq-list">{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
 </section>
</Layout>
