---
import '../styles/global.css';
import {loadContent} from '../data/content.ts';
const {company}=await loadContent();
const {title='프랜차이즈 전용유 개발과 업소용 식용유 제조',description='한산오앤에프는 프랜차이즈 전용유 개발(OEM·ODM)과 업소용 식용유 제조·소분, 전국 공급을 함께 합니다. 콩식용유·카놀라유·해바라기유·옥수수유 18L 제품과 납품 상담을 확인하세요.',schema=[],home=false}=Astro.props;
const canonical=Astro.site ? new URL(Astro.url.pathname,Astro.site).href : undefined;
const siteUrl=Astro.site?.href;
const org={'@type':'Organization','@id':siteUrl?`${siteUrl}#organization`:undefined,name:company.name,alternateName:company.en,legalName:company.name,foundingDate:company.founded,telephone:company.phone,taxID:company.tax,
 address:{'@type':'PostalAddress',streetAddress:company.address,addressLocality:'천안시',addressRegion:'충청남도',postalCode:company.postal,addressCountry:'KR'},
 ...(siteUrl?{url:siteUrl,logo:{'@type':'ImageObject',url:new URL('/favicon.svg',siteUrl).href},image:new URL('/images/oil-sculpture.webp',siteUrl).href}:{}),
 contactPoint:[{'@type':'ContactPoint',telephone:company.phone,contactType:'sales',areaServed:'KR',availableLanguage:['ko']}],
 areaServed:{'@type':'Country',name:'대한민국'},
 knowsAbout:['프랜차이즈 전용유 개발','식용유 OEM','식용유 ODM','업소용 식용유','콩식용유','카놀라유','해바라기유','옥수수유','식물성 유지 제조'],
 description:'충남 천안에서 식물성 유지를 제조·소분하고, 프랜차이즈 브랜드에 맞는 전용유를 개발해 전국에 공급하는 기업.'};
const website=siteUrl?{'@type':'WebSite','@id':`${siteUrl}#website`,url:siteUrl,name:'한산오앤에프',inLanguage:'ko-KR',publisher:{'@id':`${siteUrl}#organization`}}:null;
const nav=[['회사소개','/about/'],['전용유 개발','/business/'],['제품안내','/products/'],['품질관리','/quality/'],['오일 가이드','/guide/']];
---
<!doctype html>
<html lang="ko" style="color-scheme:light">
<head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <title>{title} | 한산오앤에프</title><meta name="description" content={description}/><meta name="theme-color" content="#faf9f6"/>
 <meta name="robots" content="index,follow,max-image-preview:large"/>{canonical&&<link rel="canonical" href={canonical}/>}
 <meta property="og:title" content={`${title} | 한산오앤에프`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="ko_KR"/>
 {canonical&&<meta property="og:url" content={canonical}/>}<meta property="og:image" content={Astro.site?new URL('/images/oil-sculpture.webp',Astro.site).href:'/images/oil-sculpture.webp'}/><meta name="twitter:card" content="summary_large_image"/>
 <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
 <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
 <link rel="preload" as="font" type="font/woff2" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/woff2/Pretendard-Bold.woff2"/>
 <link rel="preload" as="font" type="font/woff2" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/woff2/Pretendard-Regular.woff2"/>
 <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css"/>
 <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':[org,...(website?[website]:[]),...schema]}).replace(/</g,'\\u003c')}/>
</head>
<body>
 <a class="skip-link" href="#main">본문 바로가기</a>
 <header class:list={['site-header',{'on-hero':home}]}>
  <a href="/" class="brand" aria-label="한산오앤에프 홈">한산오앤에프<small>Hansan O&F</small></a>
  <nav class="desktop-nav" aria-label="주 메뉴">{nav.map(([label,href])=><a href={href} aria-current={Astro.url.pathname.startsWith(href)?'page':undefined}>{label}</a>)}</nav>
  <div class="header-actions"><a class="header-contact" href="/contact/">상담 문의</a></div>
 </header>
 <main id="main"><slot/></main>
 <nav class="tab-bar" aria-label="모바일 하단 메뉴">
  <a href="/" aria-current={Astro.url.pathname==='/'?'page':undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10"/></svg><span>홈</span></a>
  <a href="/about/" aria-current={Astro.url.pathname.startsWith('/about')?'page':undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V9l8-5 8 5v12"/><path d="M9 21v-6h6v6"/></svg><span>회사소개</span></a>
  <a href="/products/" aria-current={Astro.url.pathname.startsWith('/products')?'page':undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10l1 4H6z"/><path d="M6 7v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7"/><path d="M10 11h4"/></svg><span>제품안내</span></a>
  <a href="/quality/" aria-current={Astro.url.pathname.startsWith('/quality')?'page':undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg><span>품질관리</span></a>
  <a href="/contact/" aria-current={Astro.url.pathname.startsWith('/contact')?'page':undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/></svg><span>상담문의</span></a>
  <a href={`tel:${company.phone}`} class="tab-call"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg><span>전화</span></a>
 </nav>
 <footer class="footer"><div class="container">
  <div class="footer-top"><a href="/admin/" class="brand footer-brand" title="관리자" aria-label="한산오앤에프 관리자 페이지"><svg class="brand-icon" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="currentColor" opacity=".12"/><path d="M32 10c-7 10-14 17-14 27a14 14 0 0 0 28 0c0-10-7-17-14-27Z" fill="var(--amber)"/><path d="M32 22c-3.5 5-7 8.5-7 13.5a7 7 0 0 0 14 0c0-5-3.5-8.5-7-13.5Z" fill="var(--espresso)" opacity=".4"/></svg>한산오앤에프<small>Hansan O&F</small></a><div class="footer-links"><a href="/about/">회사소개</a><a href="/products/">제품안내</a><a href="/contact/">오시는 길 · 문의</a><a href="/privacy/">개인정보처리방침</a></div></div>
  <div class="footer-bottom"><div><p class="footer-tagline">프랜차이즈 전용유 개발 · 업소용 식용유 제조 · 전국 공급</p><strong>{company.name}</strong><p>대표 {company.ceo} · 사업자등록번호 {company.tax}</p><p>{company.address} ({company.postal})</p></div><a class="footer-phone" href={`tel:${company.phone}`}>{company.phone}<small>제품 및 납품 상담</small></a></div>
  <p class="copyright">© {new Date().getFullYear()} Hansan O&F Co., Ltd.</p>
 </div></footer>
 <a class="back-top" href="#main" aria-label="맨 위로">↑</a>
 <script src="../scripts/pointer.ts"></script>
 <script>
 const header=document.querySelector('.site-header');
 const updateHeader=()=>{header?.classList.toggle('scrolled',window.scrollY>40);document.querySelector('.back-top')?.classList.toggle('visible',window.scrollY>700)};
 addEventListener('scroll',updateHeader,{passive:true});updateHeader();
 </script>
</body>
</html>
